+package com.liskovsoft.youtubeapi.common.models.gen
+
+import com.google.gson.Gson
+import com.liskovsoft.youtubeapi.common.models.impl.mediaitem.WrapperMediaItem
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** Synthetic API cards: explicit Shorts endpoints/types, without relying on badges or shape. */
+class ShortsIdentityTest {
+    private val gson = Gson()
+
+    @Test fun videoCardsWithReelEndpointAreShortsWithoutBadge() {
+        for (renderer in listOf("videoRenderer", "gridVideoRenderer", "pivotVideoRenderer", "compactVideoRenderer")) {
+            val item = mediaItem("""{"$renderer":{
+                "videoId":"short", "navigationEndpoint":{"reelWatchEndpoint":{"videoId":"short"}}
+            }}""")
+            assertTrue(renderer, item.isShorts())
+            assertEquals("short", item.getVideoId())
+        }
+    }
+
+    @Test fun tvTileWithReelEndpointIsShortsWithoutStyleOrBadge() {
+        val item = mediaItem("""{"tileRenderer":{
+            "contentType":"TILE_CONTENT_TYPE_VIDEO",
+            "onSelectCommand":{"reelWatchEndpoint":{"videoId":"short"}}
+        }}""")
+        assertTrue(item.isShorts())
+        assertEquals("short", item.getVideoId())
+    }
+
+    @Test fun tvTileWithExplicitShortsContentTypeIsShortsWithoutBadge() {
+        val item = mediaItem("""{"tileRenderer":{
+            "contentType":"TILE_CONTENT_TYPE_SHORTS",
+            "onSelectCommand":{"watchEndpoint":{"videoId":"short"}}
+        }}""")
+        assertTrue(item.isShorts())
+        assertEquals("short", item.getVideoId())
+    }
+
+    @Test fun homeLockupWithReelEndpointRetainsShortsIdentity() {
+        val item = mediaItem("""{"lockupViewModel":{
+            "rendererContext":{"commandContext":{"onTap":{"innertubeCommand":{
+                "reelWatchEndpoint":{"videoId":"short"}
+            }}}}
+        }}""")
+        assertTrue(item.isShorts())
+        assertEquals("short", item.getVideoId())
+    }
+
+    @Test fun supportedShortsRenderersAndBadgesStillWork() {
+        for (json in listOf(
+            """{"reelItemRenderer":{"videoId":"short"}}""",
+            """{"shortsLockupViewModel":{"onTap":{"innertubeCommand":{"reelWatchEndpoint":{"videoId":"short"}}}}}""",
+            """{"videoRenderer":{"videoId":"short","thumbnailOverlays":[{"thumbnailOverlayTimeStatusRenderer":{"style":"SHORTS"}}]}}""",
+            """{"tileRenderer":{"style":"TILE_STYLE_YTLR_SHORTS","onSelectCommand":{"watchEndpoint":{"videoId":"short"}}}}"""
+        )) {
+            assertTrue(mediaItem(json).isShorts())
+        }
+    }
+
+    @Test fun standardPortraitVideoAndShortDurationAreNotShortsProof() {
+        for (duration in listOf("0:30", "60:00")) {
+            val item = mediaItem("""{"videoRenderer":{
+                "videoId":"ordinary", "navigationEndpoint":{"watchEndpoint":{"videoId":"ordinary"}},
+                "thumbnail":{"thumbnails":[{"url":"https://example.invalid/portrait.jpg","width":"1080","height":"1920"}]},
+                "lengthText":{"simpleText":"$duration"},
+                "thumbnailOverlays":[{"thumbnailOverlayTimeStatusRenderer":{"style":"DEFAULT"}}]
+            }}""")
+            assertFalse(item.isShorts())
+            assertEquals("ordinary", item.getVideoId())
+        }
+    }
+
+    @Test fun ordinaryTvTileAndHomeLockupAreNotShorts() {
+        for (json in listOf(
+            """{"tileRenderer":{"contentType":"TILE_CONTENT_TYPE_VIDEO","onSelectCommand":{"watchEndpoint":{"videoId":"ordinary"}}}}""",
+            """{"lockupViewModel":{"rendererContext":{"commandContext":{"onTap":{"innertubeCommand":{"watchEndpoint":{"videoId":"ordinary"}}}}}}}"""
+        )) {
+            val item = mediaItem(json)
+            assertFalse(item.isShorts())
+            assertEquals("ordinary", item.getVideoId())
+        }
+    }
+
+    private fun mediaItem(json: String): WrapperMediaItem = WrapperMediaItem(gson.fromJson(json, ItemWrapper::class.java))
+}
