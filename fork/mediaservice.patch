+package com.liskovsoft.youtubeapi.app;
+
+/** Keeps speculative lookups from replacing the current video's history identifier. */
+public final class PlaybackNonceState {
+    public interface Factory { String create(); }
+    private String active;
+    private final ThreadLocal<String[]> isolated = new ThreadLocal<>();
+
+    public synchronized String get(Factory factory) {
+        String[] local = isolated.get();
+        if (local != null) {
+            if (local[0] == null) local[0] = factory.create();
+            return local[0];
+        }
+        if (active == null) active = factory.create();
+        return active;
+    }
+
+    public synchronized void reset() {
+        String[] local = isolated.get();
+        if (local != null) local[0] = null;
+        else active = null;
+    }
+
+    public void beginIsolated() {
+        if (isolated.get() != null) throw new IllegalStateException("Nested playback preparation");
+        isolated.set(new String[1]);
+    }
+
+    public void endIsolated() { isolated.remove(); }
+    public synchronized void activate(String nonce) { active = nonce; }
+}
