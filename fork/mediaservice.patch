+package com.liskovsoft.youtubeapi.service;
+
+import com.liskovsoft.mediaserviceinterfaces.data.MediaItemFormatInfo;
+import com.liskovsoft.mediaserviceinterfaces.oauth.Account;
+import com.liskovsoft.sharedutils.rx.RxHelper;
+import com.liskovsoft.youtubeapi.app.AppService;
+import com.liskovsoft.youtubeapi.service.data.YouTubeMediaItemFormatInfo;
+import com.liskovsoft.youtubeapi.videoinfo.V2.VideoInfoService;
+import io.reactivex.Observable;
+
+/** A speculative result; playback cache and history change only on activation. */
+public final class PreparedShort {
+    private final MediaItemFormatInfo format;
+    private final VideoInfoService service;
+    private final String nonce;
+    private final Account account;
+    private final long created = System.nanoTime();
+
+    private PreparedShort(MediaItemFormatInfo format, VideoInfoService service, String nonce, Account account) {
+        this.format = format;
+        this.service = service;
+        this.nonce = nonce;
+        this.account = account;
+    }
+
+    public static Observable<PreparedShort> load(String videoId) {
+        return RxHelper.fromCallable(() -> {
+            Account account = YouTubeSignInService.instance().getSelectedAccount();
+            AppService app = AppService.instance();
+            app.beginShortsPreparation();
+            try {
+                if (Thread.currentThread().isInterrupted()) throw new InterruptedException();
+                VideoInfoService service = VideoInfoService.createForPreparation();
+                MediaItemFormatInfo format = YouTubeMediaItemFormatInfo.from(service.getVideoInfo(videoId, null));
+                if (Thread.currentThread().isInterrupted()) throw new InterruptedException();
+                PreparedShort result = new PreparedShort(format, service, app.getClientPlaybackNonce(), account);
+                if (!result.isValid() || !videoId.equals(format.getVideoId())) {
+                    throw new IllegalStateException("No usable prepared format");
+                }
+                return result;
+            } finally {
+                app.endShortsPreparation();
+            }
+        });
+    }
+
+    public boolean isValid() {
+        return format != null && !format.isUnplayable() && !format.isLive() && format.isCacheActual() &&
+                System.nanoTime() - created < 60_000_000_000L &&
+                account == YouTubeSignInService.instance().getSelectedAccount();
+    }
+
+    public MediaItemFormatInfo activate() {
+        if (!isValid()) return null;
+        AppService.instance().activatePreparedNonce(nonce);
+        VideoInfoService.instance().activatePreparedState(service);
+        YouTubeMediaItemService.instance().activatePreparedFormat(format);
+        return format;
+    }
+}
